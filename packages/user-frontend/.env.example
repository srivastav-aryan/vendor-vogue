# ==============================================================================
# Vendor Vogue - Storefront User Frontend Environment Configuration
# ==============================================================================

# Public API URL used by the browser to reach the backend API
# In production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Internal API URL used by Next.js Server Components / SSR
# If running in same VPC/Docker network: http://backend:5000
# Otherwise set to the same public URL: https://api.yourdomain.com
API_INTERNAL_URL=http://localhost:5000

# Public Storefront URL (used for canonical links, OpenGraph tags, sitemap.xml, robots.txt)
# In production: https://vendorvogue.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay Public Key ID (Client-facing checkout modal)
# In production: rzp_live_xxxxxxxxxxxx or rzp_test_xxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Cloudinary Cloud Name for dynamic image transformation & CDN delivery
# In production: your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
