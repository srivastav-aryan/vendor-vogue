# ==============================================================================
# Vendor Vogue - Admin Operations Frontend Environment Configuration
# ==============================================================================

# Public API URL used by the browser to reach the backend API
# In production: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Internal API URL used by Next.js Server Components / SSR (RSC)
# If backend and admin frontend are in the same private network (e.g., Docker/Kubernetes): http://backend:5000
# Otherwise set to the same public URL: https://api.yourdomain.com
API_INTERNAL_URL=http://localhost:5000
