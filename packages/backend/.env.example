# ==============================================================================
# Vendor Vogue - Backend API Environment Configuration
# ==============================================================================

# Server Port (in production, cloud platforms like Render/Railway/AWS assign PORT automatically)
PORT=5000

# Environment mode: development | production | testing
NODE_ENV=development

# MongoDB Connection String:
# In development: mongodb://localhost:27017/ecomDB?replicaSet=rs0&directConnection=true
# In production: Use MongoDB Atlas connection string with replica set (required for Mongoose transactions):
# mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/ecomDB?retryWrites=true&w=majority
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/ecomDB?replicaSet=rs0&directConnection=true

# JWT Authentication Secrets (Generate secure 64-byte hex: `openssl rand -hex 64`)
ACCESS_TOKEN_SECRET=your_super_secret_jwt_access_token_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_token_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Rate limiting for login
LOGIN_WINDOW_MS=10000
LOGIN_MAX_ATTEMPTS=5

# CORS Allowed Origins (CRITICAL FOR PRODUCTION):
# Comma-separated list of allowed frontend origins (NO trailing slashes!)
# In development: http://localhost:3000,http://localhost:3001
# In production: https://vendorvogue.com,https://admin.vendorvogue.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Razorpay Payment Gateway Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# In production: live keys (rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
# Webhook secret configured in Razorpay Dashboard pointing to https://api.yourdomain.com/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Cloudinary Storage for Catalog & Media Uploads
CLOUDINARY_CLOUD_NAME=placeholder_cloud
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret
CLOUDINARY_UPLOAD_FOLDER=vendor-vogue/products
